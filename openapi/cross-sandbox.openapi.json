        "title": "Measurement",
        "type": "object"
      },
      "MeasurementRecord": {
        "additionalProperties": false,
        "properties": {
          "device": {
            "$ref": "#/components/schemas/Device"
          },
          "device_id": {
            "pattern": "^demo-[A-Za-z0-9.-]{1,50}$",
            "title": "Device Id",
