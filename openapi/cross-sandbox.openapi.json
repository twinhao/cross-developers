            "type": "string"
          },
          "event_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Event Id",
            "type": "string"
          },
          "heart_rate": {
            "exclusiveMinimum": 0.0,
            "maximum": 400.0,
            "title": "Heart Rate",
            "type": "number"
          },
          "measured_at": {
            "format": "date-time",
            "title": "Measured At",
            "type": "string"
          },
          "patient_id": {
            "pattern": "^demo-[A-Za-z0-9.-]{1,50}$",
            "title": "Patient Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "unit": {
            "const": "/min",
            "default": "/min",
            "title": "Unit",
            "type": "string"
          }
