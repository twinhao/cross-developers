          "external_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "External Id",
            "type": "string"
          },
          "firmware_version": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Firmware Version",
            "type": "string"
          },
          "id": {
            "pattern": "^demo-[A-Za-z0-9.-]{1,50}$",
            "title": "Id",
            "type": "string"
          },
          "manufacturer": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Manufacturer",
            "type": "string"
          },
          "model": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Model",
            "type": "string"
          },
          "source_system": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Source System",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_system",
          "external_id",
          "manufacturer",
          "model",
          "firmware_version"
        ],
        "title": "Device",
        "type": "object"
      },
      "EcgMeasurement": {
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "pattern": "^demo-[A-Za-z0-9.-]{1,50}$",
            "title": "Device Id",
            "type": "string"
          },
          "event_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Event Id",
            "type": "string"
          },
          "measured_at": {
            "format": "date-time",
            "title": "Measured At",
            "type": "string"
          },
          "patient_id": {
            "pattern": "^demo-[A-Za-z0-9.-]{1,50}$",
            "title": "Patient Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "unit": {
            "const": "uV",
            "default": "uV",
            "title": "Unit",
            "type": "string"
          },
          "waveform": {
            "$ref": "#/components/schemas/EcgWaveform"
          }
        },
        "required": [
          "event_id",
          "patient_id",
          "device_id",
          "measured_at",
          "waveform"
        ],
        "title": "EcgMeasurement",
        "type": "object"
      },
      "EcgRecord": {
        "additionalProperties": false,
        "properties": {
          "device": {
            "$ref": "#/components/schemas/Device"
          },
          "device_id": {
            "pattern": "^demo-[A-Za-z0-9.-]{1,50}$",
            "title": "Device Id",
            "type": "string"
          },
          "duration_ms": {
            "title": "Duration Ms",
            "type": "number"
          },
          "event_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Event Id",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "const": "ecg",
            "default": "ecg",
            "title": "Kind",
            "type": "string"
          },
          "measured_at": {
            "format": "date-time",
            "title": "Measured At",
            "type": "string"
          },
          "patient": {
            "$ref": "#/components/schemas/Patient"
          },
          "patient_id": {
            "pattern": "^demo-[A-Za-z0-9.-]{1,50}$",
            "title": "Patient Id",
            "type": "string"
          },
          "received_at": {
            "format": "date-time",
            "title": "Received At",
            "type": "string"
          },
          "sample_count": {
            "title": "Sample Count",
            "type": "integer"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "unit": {
            "const": "uV",
            "default": "uV",
            "title": "Unit",
            "type": "string"
          },
          "waveform": {
            "$ref": "#/components/schemas/EcgWaveform"
          }
        },
        "required": [
          "event_id",
          "patient_id",
          "device_id",
          "measured_at",
          "waveform",
          "id",
          "received_at",
          "patient",
          "device",
          "sample_count",
          "duration_ms"
        ],
        "title": "EcgRecord",
        "type": "object"
      },
      "EcgWaveform": {
        "additionalProperties": false,
        "properties": {
          "calibration": {
            "const": "physical-microvolts",
            "title": "Calibration",
            "type": "string"
          },
          "filtering": {
            "const": "none",
            "title": "Filtering",
            "type": "string"
          },
          "lead": {
            "const": "I",
            "title": "Lead",
            "type": "string"
          },
          "sample_rate_hz": {
            "maximum": 1000.0,
            "minimum": 50.0,
            "title": "Sample Rate Hz",
            "type": "integer"
          },
          "sample_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sample Sha256",
            "type": "string"
          },
          "samples": {
            "items": {
              "maximum": 100000.0,
              "minimum": -100000.0,
              "type": "integer"
            },
            "maxItems": 5000,
            "minItems": 2,
            "title": "Samples",
            "type": "array"
          },
          "signal_origin": {
            "const": "simulator",
            "title": "Signal Origin",
            "type": "string"
          }
        },
        "required": [
          "lead",
          "sample_rate_hz",
          "samples",
          "sample_sha256",
          "signal_origin",
          "calibration",
          "filtering"
        ],
        "title": "EcgWaveform",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
